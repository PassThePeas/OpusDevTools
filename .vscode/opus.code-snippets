	"Opus Index Reference": {
        "prefix": "refindex",
        "body": [
            "/// <reference path=\"./OpusDevTools/typings/index.d.ts\" />",
            "$0"
        ],
        "description": "Forces global IntelliSense(API + Includes) on .js.txt files"
    },

	"Opus Add_Include": {
        "prefix": "//include",
        "body": [
            "//@@include inc_${1:incFileName}.js",
            "$0"
        ],
        "description": "Inserts Opus include directive"
    },

	"Enumerator Loop": {
		"prefix": "forenum",
		"body": [
			"for (var ${2:e} = new Enumerator(${1:collection}); !${2:e}.atEnd(); ${2:e}.moveNext()) {",
			"\t/** @type {${4:itemType}} */",
			"\tvar ${3:item} = ${2:e}.item();",
			"\t$0",
			"}"
		],
		"description": "Enumerator loop for Directory Opus (JScript)"
	},

	"Enumerator Map Loop": {
		"prefix": "formapenum",
		"body": [
			"for (var ${2:e} = new Enumerator(${1:map}); !${2:e}.atEnd(); ${2:e}.moveNext()) {",
			"\t/** @type {${4:keyType}} */",
			"\tvar ${3:key} = ${2:e}.item();",
			"\t/** @type {${6:itemType}} */",
			"\tvar ${5:item} = ${1:map}(${3:key});",
			"\t$0",
			"}"
		],
		"description": "Enumerator loop for Directory Opus (JScript)"
	},

	"Opus Simple Dialog": {
		"prefix": "opdlg",
		"body": [
		"var ${1:dlg} = DOpus.Dlg();",
		"${1:dlg}.title = \"${2:Title}\";",
		"${1:dlg}.message = \"${3:Your message here}\";",
		"${1:dlg}.buttons = \"${4:OK|Cancel}\";",
		"var ${5:res} = ${1:dlg}.Show();",
		"$0"
		],
		"description": "Directory Opus simple dialog"
	},

	"Opus Command Object": {
		"prefix": "opcmd",
		"body": [
			"var ${1:cmd} = DOpus.Create().Command();",
			"${1:cmd}.SetSourceTab(${2:clickData.func.sourcetab});",
			"${1:cmd}.AddFiles(${3:clickData.func.sourcetab.selected});",
			"${1:cmd}.RunCommand(\"${4:Command Name}\");",
			"$0"
		],
		"description": "Create and execute an Opus command on selected files"
	},

	"Opus Loop Selected Files (Add-in)": {
		"prefix": "opselfiles",
		"body": [
			"var ${1:items} = ${2|scriptCmdData,clickData|}.func.sourcetab.selected;",
			"for (var ${3:e} = new Enumerator(${1:items}); !${3:e}.atEnd(); ${3:e}.moveNext()) {",
			"\t/** @type {Item} */",
			"\tvar ${4:item} = ${3:e}.item();",
			"\t",
			"\tDOpus.Output(\"Processing : \" + ${4:item}.name);",
			"\t$0",
			"}"
		],
		"description": "Enumerator loop on selection (scriptCmdData or clickData)"
	},

	"loginit_core": {
		"prefix": "loginit_core",
		"body": [
			"var consoleTarget = LoggerNS.BuildTargetFromTemplate(\"Default Console\");",
			"consoleTarget.minLevel = LoggerNS.LogLevel.Debug;",
			"logger = new LoggerNS.Logger(LoggerNS.BuildTargetFromTemplate(\"Default File\", \"${TM_FILENAME_BASE}\"), consoleTarget);",
			"logger.info(\"${TM_FILENAME_BASE}::${CLIPBOARD/^On//}\");",
			"$0"
		],
		"description": "logger init with current file name and dynamic function"
	},

	"Logger Init Clipboard": {
		"prefix": "loginit",
		"body": [
			"var consoleTarget = LoggerNS.BuildTargetFromTemplate(\"Default Console\");",
			"consoleTarget.minLevel = LoggerNS.LogLevel.Debug;",
			"logger = new LoggerNS.Logger(LoggerNS.BuildTargetFromTemplate(\"Default File\", \"${TM_FILENAME_BASE}\"), consoleTarget);",
			"logger.info(\"${TM_FILENAME_BASE}::${CLIPBOARD/^On//}\");",
			"$0"
		],
		"description": "logger init using clipboard as function name (remove the initial 'On' in the function name)"
	},

	"JSDoc Type": {
		"prefix": "dectype",
		"body": [
			"/** @type {${1:objType}} */",
			"$0"
		],
		"description": "inserts jsdoc decoration to force next object type"
	}

}